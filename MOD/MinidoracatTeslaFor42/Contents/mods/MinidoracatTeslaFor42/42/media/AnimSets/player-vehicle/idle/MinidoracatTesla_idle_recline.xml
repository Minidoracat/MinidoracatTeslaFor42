<?xml version="1.0" encoding="utf-8"?>
<!-- Front seats of a Tesla: the seated idle leaned back 25 deg with the thighs lowered (MinidoracatTesla_IdleDrivingRecline,
     made from vanilla Bob_IdleDriving by scripts/seat_anim.py into media/anims_X/Bob: a MOD's other anims_X folders are
     read only next to a common/media/anims_X, ModelManager.java:1678-1699,1807-1823). Vanilla's idle/default.xml is the
     only idle node and has no conditions; m_ConditionPriority 2 puts this one before the rear rows' node (1, both match
     in a front seat) and vanilla's (AnimNode.java:358-370, AnimState.java:40-53). Driving, steering, reversing, the
     horn, opening a door from the seat and sleeping stay in this state (the player-vehicle actiongroup has no other
     state for them). The variables are set by client/MinidoracatTesla/SeatPose.lua. Written out in full, no x_extends
     (family pitfalls.md, Linux servers). -->
<animNode>
	<m_Name>MinidoracatTesla_idle_recline</m_Name>
	<m_ConditionPriority>2</m_ConditionPriority>
	<m_AnimName>MinidoracatTesla_IdleDrivingRecline</m_AnimName>
	<m_BlendTime>0.20</m_BlendTime>
	<m_SpeedScale>0.80</m_SpeedScale>
	<m_Conditions>
		<m_Name>MinidoracatTeslaRecline</m_Name>
		<m_Type>BOOL</m_Type>
		<m_Value>true</m_Value>
	</m_Conditions>
</animNode>
